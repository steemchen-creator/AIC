AIC_ENVIRONMENT=development
AIC_LOG_LEVEL=INFO
AIC_POSTGRES_DB=aic
AIC_POSTGRES_USER=aic
AIC_POSTGRES_PASSWORD=replace-with-local-secret
AIC_DATABASE_URL=postgresql+asyncpg://aic:replace-with-local-secret@localhost:5432/aic
AIC_REDIS_URL=redis://localhost:6379/0
AIC_CELERY_BROKER_URL=redis://localhost:6379/1
AIC_CELERY_RESULT_BACKEND=redis://localhost:6379/2
AIC_VERIFY_DEPENDENCIES=false
AIC_TUSHARE_TOKEN=
AIC_HISTORICAL_CHUNK_DAYS=365
