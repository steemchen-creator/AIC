<Window x:Class="AIC.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AIC"
        Width="720"
        Height="420"
        MinWidth="560"
        MinHeight="320"
        WindowStartupLocation="CenterScreen"
        Background="#0B1220">
    <Grid>
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    TextElement.Foreground="#F8FAFC">
            <TextBlock Text="AIC"
                       HorizontalAlignment="Center"
                       FontSize="64"
                       FontWeight="Bold" />
            <TextBlock Text="AI Investment Command Center"
                       Margin="0,16,0,0"
                       HorizontalAlignment="Center"
                       FontSize="24" />
            <TextBlock Text="Version 0.1"
                       Margin="0,12,0,0"
                       HorizontalAlignment="Center"
                       Foreground="#94A3B8"
                       FontSize="16" />
        </StackPanel>
    </Grid>
</Window>
